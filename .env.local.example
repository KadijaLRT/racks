# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing a real key.

# Required: server-side only, read via process.env in lib/groq.ts.
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Optional overrides if Groq deprecates the default models
# (see console.groq.com/docs/models for current names)
GROQ_VISION_MODEL=
GROQ_TEXT_MODEL=
